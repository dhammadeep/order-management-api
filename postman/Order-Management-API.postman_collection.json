{
  "info": {
    "name": "Order Management API",
    "description": "Laravel 11 order management API. The webhook secret variable is a local-only placeholder; set it to the same secret as PAYMENT_WEBHOOK_SECRET in your untracked .env. The webhook pre-request script signs the raw body bytes included in this collection request.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Health check",
          "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{baseUrl}}/health" }
        },
        {
          "name": "Register customer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Local Customer\",\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\",\n  \"password_confirmation\": \"{{customerPassword}}\"\n}" },
            "url": "{{baseUrl}}/register"
          }
        },
        {
          "name": "Customer login (save customerToken)",
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": ["pm.test('login succeeds', function () { pm.response.to.have.status(200); });", "const response = pm.response.json();", "if (response.data && response.data.access_token) pm.collectionVariables.set('customerToken', response.data.access_token);"] }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\"\n}" },
            "url": "{{baseUrl}}/login"
          }
        },
        {
          "name": "Admin login (save adminToken)",
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": ["pm.test('admin login succeeds', function () { pm.response.to.have.status(200); });", "const response = pm.response.json();", "if (response.data && response.data.access_token) pm.collectionVariables.set('adminToken', response.data.access_token);"] }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}" },
            "url": "{{baseUrl}}/login"
          }
        },
        {
          "name": "Current user",
          "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{customerToken}}" }], "url": "{{baseUrl}}/me" }
        },
        {
          "name": "Logout customer token",
          "request": { "method": "POST", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{customerToken}}" }], "url": "{{baseUrl}}/logout" }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "Admin create product",
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": ["pm.test('product created', function () { pm.response.to.have.status(201); });", "const response = pm.response.json();", "if (response.data && response.data.product) pm.collectionVariables.set('productId', response.data.product.id);"] }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Stainless Steel Water Bottle\",\n  \"sku\": \"HOME-BTL-101\",\n  \"price\": \"18.50\",\n  \"stock_quantity\": 24,\n  \"status\": \"active\"\n}" },
            "url": "{{baseUrl}}/products"
          }
        },
        {
          "name": "Admin update product",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"price\": \"19.95\",\n  \"stock_quantity\": 30\n}" },
            "url": "{{baseUrl}}/products/{{productId}}"
          }
        },
        {
          "name": "Admin list/filter products",
          "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/products?status=inactive&page=1&per_page=15" }
        },
        {
          "name": "Customer list/search active products",
          "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{customerToken}}" }], "url": "{{baseUrl}}/products?search=bottle&page=1&per_page=15" }
        },
        {
          "name": "Get product",
          "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{customerToken}}" }], "url": "{{baseUrl}}/products/{{productId}}" }
        },
        {
          "name": "Admin soft-delete product",
          "request": { "method": "DELETE", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/products/{{productId}}" }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Customer create order (save orderId)",
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": ["pm.test('order created', function () { pm.response.to.have.status(201); });", "const response = pm.response.json();", "if (response.data && response.data.order) pm.collectionVariables.set('orderId', response.data.order.id);"] }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"items\": [\n    { \"product_id\": {{productId}}, \"quantity\": 2 }\n  ]\n}" },
            "url": "{{baseUrl}}/orders"
          }
        },
        {
          "name": "Customer list own orders",
          "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{customerToken}}" }], "url": "{{baseUrl}}/orders?page=1&per_page=15" }
        },
        {
          "name": "Get order detail",
          "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{customerToken}}" }], "url": "{{baseUrl}}/orders/{{orderId}}" }
        }
      ]
    },
    {
      "name": "Payment and reports",
      "item": [
        {
          "name": "Payment webhook (HMAC from exact raw body)",
          "event": [{
            "listen": "prerequest",
            "script": { "type": "text/javascript", "exec": ["const rawBody = pm.request.body.raw;", "const secret = pm.collectionVariables.get('webhookSecret');", "if (!secret || secret === 'local-only-replace-me') throw new Error('Set webhookSecret to the local .env test secret first.');", "const signature = CryptoJS.HmacSHA256(rawBody, secret).toString(CryptoJS.enc.Hex);", "pm.request.headers.upsert({ key: 'X-Signature', value: signature });"] }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"transaction_id\": \"TXN-LOCAL-CHANGE-ME\",\n  \"order_id\": 1,\n  \"amount\": \"1500.00\",\n  \"status\": \"success\"\n}" },
            "url": "{{baseUrl}}/webhooks/payment"
          },
          "description": "The pre-request script computes HMAC-SHA256 over this exact raw body. Replace the example order ID and transaction ID with a pending local order and a unique transaction ID. The collection secret is a local-only placeholder, not a production secret."
        },
        {
          "name": "Admin top-products report",
          "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/admin/reports/top-products?from_date=2026-06-01&to_date=2026-06-30" }
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api", "type": "string" },
    { "key": "customerEmail", "value": "customer@example.test", "type": "string" },
    { "key": "customerPassword", "value": "local-example-customer-password", "type": "string" },
    { "key": "adminEmail", "value": "admin@example.test", "type": "string" },
    { "key": "adminPassword", "value": "change-this-local-admin-password", "type": "string" },
    { "key": "customerToken", "value": "", "type": "string" },
    { "key": "adminToken", "value": "", "type": "string" },
    { "key": "productId", "value": "1", "type": "string" },
    { "key": "orderId", "value": "1", "type": "string" },
    { "key": "webhookSecret", "value": "local-only-replace-me", "type": "string" }
  ]
}
